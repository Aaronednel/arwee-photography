VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EmailJS (custom HTML email notifications, zero activation steps)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
