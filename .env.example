# Copy to .env and fill in. Only PUBLIC values belong here (VITE_* is exposed to the browser).
# Configure ONE option. Leave all empty and the form will honestly report it is not connected.

# Option A — Supabase (anon key only, protected by Row Level Security; see README)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Option B — any JSON endpoint (Formspree, Web3Forms, custom API)
VITE_INQUIRY_ENDPOINT=
